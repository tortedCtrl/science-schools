POSTGRES_HOST=127.0.0.1 # Внешний адрес PostgreSQL
POSTGRES_PORT=5432 # Порт PostgreSQL внутри Docker-сети
POSTGRES_PUBLISHED_PORT=5433 # Внешний порт PostgreSQL

BACKEND_PORT=8080
# Опциональные настройки BigClam (сейчас не могут быть применены, т.к. окружение не прокидывается в докер)
BIGCLAM_BINARY=/usr/local/bin/bigclam
BIGCLAM_COMMUNITIES=10
BIGCLAM_THREADS=1

FRONTEND_PORT=5173

POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_secret_password
POSTGRES_DB=your_db_name

VCPKG_ROOT=/absolute/path/to/vcpkg